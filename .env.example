# --- required ---
SHOTLAB_POSTGRES_PASSWORD=change-me
# Folder (ideally a NAS share) holding incoming/ processed/ failed/ clips/
VIDEO_DIR=/mnt/nas/basketball

# --- optional ---
SHOTLAB_POSTGRES_USER=shots
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# Models (files in ./models are mounted at /models)
OBJECT_MODEL=/models/ball_rim.pt
POSE_MODEL=yolo11s-pose.pt        # downloaded automatically on first run
# Class names in your ball/rim model (case-insensitive, comma-separated)
BALL_CLASSES=ball,basketball
RIM_CLASSES=rim,hoop,basketball hoop
BALL_CONF=0.30
RIM_CONF=0.40
POSE_CONF=0.40
DEVICE=0                          # GPU index, or "cpu"
IMGSZ=960                         # bigger = better for a small far-away ball, slower

# Shot logic
SHOOTING_HAND=auto                # auto | right | left
MAKE_TOLERANCE=0.6                # how close to rim centre counts as a make (see README)
MAX_MAKE_EXIT_SPEED=              # e.g. 3.0 to score fast rim exits as misses; empty = off
MAKE_CLASSIFIER=                  # e.g. /models/make_cls.pt (see README); empty = off
MAKE_CLASSIFIER_THRESHOLD=0.8     # a make is scored a miss when the classifier's p(miss) is above this
MAX_FLIGHT_S=3.0
SHOT_COOLDOWN_S=0.5

# Worker
POLL_SECONDS=15
MAKE_CLIPS=true
DEBUG_VIDEO=false                 # annotated copy of every session in debug/
