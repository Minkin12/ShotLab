      "options": {
        "xField": "bucket",
        "orientation": "vertical",
        "showValue": "auto",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        },
        "xTickLabelRotation": -30
      }
    },
    {
      "id": 12,
      "type": "barchart",
      "title": "Make % by knee bend",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "shotdb"
      },
      "gridPos": {
        "x": 16,
        "y": 17,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "shotdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT (floor(min_knee_angle / 10) * 10)::int || '-' || (floor(min_knee_angle / 10) * 10 + 10)::int\n       || '° (n=' || count(*) || ')' AS bucket,\n       round(100.0 * avg(made::int), 1) AS \"make %\"\nFROM shots\nWHERE $__timeFilter(shot_time) AND min_knee_angle IS NOT NULL\nGROUP BY floor(min_knee_angle / 10)\nHAVING count(*) >= 3\nORDER BY floor(min_knee_angle / 10)"
        }
      ],
      "description": "Lower angle = deeper dip. Tired legs show up as shallower dips late in sessions.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "bucket",
        "orientation": "vertical",
        "showValue": "auto",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        },
        "xTickLabelRotation": -30
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Fatigue check: shot by shot",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "shotdb"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "shotdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT shot_time AS time,\n       min_knee_angle AS \"knee bend\",\n       release_elbow_angle AS \"release elbow\",\n       launch_angle_deg AS \"launch angle\"\nFROM shots WHERE $__timeFilter(shot_time) ORDER BY 1"
        }
      ],
      "description": "Zoom into a single session to see whether your legs or arc drop off as you tire.",
      "fieldConfig": {
        "defaults": {
          "unit": "degree",
          "custom": {
            "drawStyle": "points",
            "pointSize": 6,
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "table",
      "title": "Shots",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "shotdb"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "shotdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT shot_time AS \"time\",\n       CASE WHEN made THEN 'MAKE' ELSE 'miss' END AS \"result\",\n       launch_angle_deg AS \"launch\", entry_angle_deg AS \"entry\",\n       release_speed_mps AS \"speed m/s\", release_elbow_angle AS \"elbow\",\n       min_knee_angle AS \"knee\", dip_to_release_ms AS \"dip ms\",\n       torso_lean_deg AS \"lean\", exit_speed_mps AS \"exit m/s\", make_prob AS \"make prob\", form_confidence AS \"pose conf\",\n       clip_path AS \"clip\"\nFROM shots WHERE $__timeFilter(shot_time) ORDER BY shot_time DESC LIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "result"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "MAKE": {
                        "color": "green",
                        "index": 0
                      },
                      "miss": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Suspect makes",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "shotdb"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "shotdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FROM shots WHERE $__timeFilter(shot_time) AND made\n  AND (exit_speed_mps > ${suspect} OR make_prob < 0.5)"
        }
      ],
      "description": "Makes where the ball dropped away from the rim fast, or the make/miss classifier leans towards a miss - possible rattle-outs or balls falling just in front of/behind the rim.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 16,
      "type": "table",
      "title": "Suspect makes (fast exit or classifier unsure)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "shotdb"
      },
      "gridPos": {
        "x": 4,
