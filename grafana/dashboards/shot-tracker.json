          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT shot_time AS \"time\", s.video_file AS \"session\", sh.shot_number AS \"shot\",\n       exit_speed_mps AS \"exit m/s\", make_prob AS \"make prob\", rim_offset AS \"rim offset\", clip_path AS \"clip\"\nFROM shots sh JOIN sessions s ON s.id = sh.session_id\nWHERE $__timeFilter(shot_time) AND made AND (exit_speed_mps > ${suspect} OR make_prob < 0.5)\nORDER BY make_prob NULLS LAST, exit_speed_mps DESC"
